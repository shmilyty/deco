# Required in all environments
SECRET_KEY=your-aes-encryption-secret
JWT_SECRET=your-jwt-signing-secret

# LinuxDo OAuth (required in production)
LINUXDO_CLIENT_ID=your_client_id_here
LINUXDO_CLIENT_SECRET=your_client_secret_here
LINUXDO_REDIRECT_URI=https://yourdomain.com/api/auth/callback

# Cloudflare Turnstile (required in production)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Admin user
ADMIN_LINUXDO_ID=99999

# Database
DATABASE_URL=file:./dev.db

# Optional
PORT=3000
NODE_ENV=development
UNLOCK_DATE=2025-12-25T00:00:00
DEV_FRONTEND_URL=http://localhost:5173

# CORS allowed origins (comma-separated, required in production)
ALLOWED_ORIGINS=https://yourdomain.com

# SMTP email configuration (optional, logs to console if not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Deco My Tree <noreply@example.com>

# Email domain whitelist (comma-separated, empty = allow all domains)
# EMAIL_DOMAIN_WHITELIST=gmail.com,qq.com,163.com,outlook.com

# Frontend (Vite) env vars (place in root .env)
# VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
